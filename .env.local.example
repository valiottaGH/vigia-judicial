# Supabase (obligatorio)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=tu@gmail.com
# Emails con acceso admin (opcional, separados por coma). También se puede marcar is_admin en Supabase.
ADMIN_EMAILS=tu@gmail.com

# IA — OpenRouter (recomendado)
# Creá una key en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Modelo: ver https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini
# Opcional — aparece en el ranking de OpenRouter
# OPENROUTER_APP_NAME=Fast Cedu

# IA — OpenAI directo (alternativa; solo si no usás OpenRouter)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Mercado Pago — Checkout Bricks
# Credenciales en https://www.mercadopago.com.ar/developers/panel/app
# TEST: credenciales de prueba. PROD: credenciales de produccion.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-...
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-...
# Clave secreta del webhook (Mercado Pago > Webhooks > Configurar > revelar)
MERCADOPAGO_WEBHOOK_SECRET=tu-clave-secreta-webhook

# --- Modulo SISFE (PAUSADO — ver _archive/sisfe/README.md) ---
# SISFE_BASE_URL=https://sisfe.justiciasantafe.gov.ar
# SISFE_LOGIN_URL=https://sisfe.justiciasantafe.gov.ar/login-matriculado
# NEXT_PUBLIC_SISFE_LOGIN_URL=https://sisfe.justiciasantafe.gov.ar/login-matriculado
# SISFE_MOCK=true
# SISFE_SESSION_SECRET=secreto-largo-aleatorio

# Prueba de aislamiento RLS (opcional, scripts/test-rls-isolation.mjs)
# RLS_TEST_USER_A_EMAIL=cuenta-a@test.com
# RLS_TEST_USER_A_PASSWORD=********
# RLS_TEST_USER_B_EMAIL=cuenta-b@test.com
# RLS_TEST_USER_B_PASSWORD=********

# Soporte — formulario de atención al cliente (Resend)
# Creá una key en https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Tu Gmail: acá llegan las consultas del widget "Atención al cliente"
SUPPORT_INBOX_EMAIL=valentinoliotta3691@gmail.com
# Email visible en la app (fallback si falta SUPPORT_INBOX_EMAIL)
NEXT_PUBLIC_SUPPORT_EMAIL=valentinoliotta3691@gmail.com
# Remitente: con dominio sin verificar usá onboarding@resend.dev (solo envía a tu cuenta Resend)
# Con dominio verificado en Resend: Fast Cedu <soporte@tudominio.com>
RESEND_FROM_EMAIL=Fast Cedu <onboarding@resend.dev>
